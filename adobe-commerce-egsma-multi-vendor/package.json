{
  "name": "adobe-commerce-egsma-multi-vendor",
  "description": "User guide for the EGSMA Multi-Vendor Marketplace Integration for Adobe Commerce (App Builder).",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "CHOKIDAR_USEPOLLING=true WATCHPACK_POLLING=true vuepress dev docs --clean-cache --clean-temp --host 0.0.0.0 -p 8099",
    "build": "vuepress build docs --clean-cache --clean-temp",
    "clean": "rm -rf docs/.vuepress/.cache docs/.vuepress/.temp docs/.vuepress/dist",
    "fresh": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@vuepress/bundler-webpack": "2.0.0-rc.20",
    "@vuepress/plugin-search": "2.0.0-rc.86",
    "@vuepress/theme-default": "2.0.0-rc.88",
    "html2canvas": "1.4.1",
    "jspdf": "2.5.2",
    "mermaid": "11.14.0",
    "sass-embedded": "1.99.0",
    "sass-loader": "16.0.7",
    "vue": "3.5.32",
    "vuepress": "2.0.0-rc.20",
    "vuepress-plugin-md-enhance": "2.0.0-rc.72"
  }
}
