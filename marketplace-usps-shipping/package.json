{
  "name": "magento2-marketplace-usps-shipping",
  "description": "User guide for installing, configuring, and managing the Marketplace USPS Shipping extension for Magento 2.",
  "version": "1.0.0",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "start": "vuepress dev docs --clean-cache --clean-temp -p 8090",
    "build": "vuepress build docs --clean-cache --clean-temp",
    "build:site": "VUEPRESS_BASE=/marketplace-usps-shipping/ vuepress build docs --clean-cache --clean-temp",
    "clean": "rm -rf docs/.vuepress/.cache docs/.vuepress/.temp docs/.vuepress/dist"
  },
  "devDependencies": {
    "@vuepress/bundler-webpack": "2.0.0-rc.20",
    "@vuepress/plugin-search": "2.0.0-rc.86",
    "@vuepress/theme-default": "2.0.0-rc.88",
    "html2canvas": "1.4.1",
    "jspdf": "2.5.2",
    "mermaid": "11.14.0",
    "sass-embedded": "1.99.0",
    "sass-loader": "16.0.7",
    "vue": "3.5.32",
    "vuepress": "2.0.0-rc.20",
    "vuepress-plugin-md-enhance": "2.0.0-rc.72"
  }
}
