{
  "name": "magento2-demo-blog-docs",
  "version": "1.0.0",
  "description": "User guide documentation for the Webkul Magento 2 Demo Blog extension.",
  "type": "module",
  "scripts": {
    "start": "vuepress dev docs --clean-cache --clean-temp -p 8081",
    "build": "vuepress build docs --clean-cache --clean-temp",
    "clean": "rm -rf docs/.vuepress/.cache docs/.vuepress/.temp docs/.vuepress/dist"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20 <23"
  },
  "devDependencies": {
    "@vuepress/bundler-webpack": "2.0.0-rc.20",
    "@vuepress/plugin-search": "2.0.0-rc.86",
    "@vuepress/theme-default": "2.0.0-rc.88",
    "mermaid": "11.14.0",
    "sass-embedded": "1.99.0",
    "sass-loader": "16.0.7",
    "vue": "3.5.32",
    "vuepress": "2.0.0-rc.20",
    "vuepress-plugin-md-enhance": "2.0.0-rc.72"
  }
}
